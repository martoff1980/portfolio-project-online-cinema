# Параметры базы данных PostgreSQL
POSTGRES_USER=cinema_admin
POSTGRES_PASSWORD=cinema_secure_pass
POSTGRES_DB=online_cinema_db
DB_HOST=db
DB_PORT=5432

# URL подключения к БД для SQLAlchemy (асинхронный asyncpg)
# DATABASE_URL=postgresql+asyncpg://cinema_admin:cinema_secure_pass@db:5432/online_cinema_db
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${DB_HOST}:${DB_PORT}/${POSTGRES_DB}

# Брокер сообщений Redis
REDIS_URL=redis://redis:6379/0

# Настройки Stripe (если есть, иначе включится режим заглушки)
